# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PATIENT_DATA_KEY=
# Any long random string
PATIENT_HASH_KEY=
STAFF_API_KEY=
TOOLS_API_KEY=
# Who answers calls (web 📞 and WhatsApp 📞): sarvam_agent = the hosted Sarvam agent below, local = our own pipeline.
# Messages, maps, slips and memory always use our own code.
CALL_ENGINE=sarvam_agent
SARVAM_AGENT_APP_ID=
SARVAM_AGENT_ORG_ID=
SARVAM_AGENT_WORKSPACE_ID=
# The agent platform key (indus.sarvam.ai), not SARVAM_API_KEY
SARVAM_AGENT_API_KEY=
# Empty = the newest committed version of the agent
SARVAM_AGENT_VERSION=
# WhatsApp through Meta (WHATSAPP_PROVIDER=meta); anything else uses the TWILIO_ settings
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_URL=
# twiml for a Twilio trial account (it refuses free-form REST sends); leave empty on a paid account
TWILIO_REPLY_MODE=
