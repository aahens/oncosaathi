# Copy to .env and fill in. Never commit .env.

# Sarvam (required)
SARVAM_API_KEY=

# WhatsApp Cloud API (only needed for the real WhatsApp bot; the browser demo works without these)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Any password you invent; type the same value into Meta's webhook settings
WA_VERIFY_TOKEN=
# App Dashboard > App settings > Basic > App secret (used to check Meta's signature)
WA_APP_SECRET=
WA_GRAPH_VERSION=v23.0

# Optional
HELP_DESK_NUMBER=the hospital help desk
USE_LLM_FALLBACK=1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=0.9
